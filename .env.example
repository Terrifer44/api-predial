# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL=

# Porta do servidor backend
PORT=3000

# URL do frontend (usada para montar o link de redefinição de senha)
FRONTEND_URL=
# Configuração de SMTP para envio de e-mails (notificações e recuperação de senha).
# Se deixar em branco, os e-mails são apenas simulados no console do servidor.
# Exemplo usando Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sistema de Manutenção Predial <nao-responda@predial.com>"

# Upload de fotos das demandas (Cloudinary — recomendado em produção).
# Crie uma conta grátis em cloudinary.com; o Dashboard mostra os 3 valores abaixo.
# Sem isso, o sistema usa disco local (/uploads) — que NÃO sobrevive a redeploys
# em serviços com disco efêmero, como o plano gratuito do Render.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


